<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{{ site_config.title }} — {{ site_config.server_name }}</title>
    <style>
        body { font-family: sans-serif; background: {{ site_config.color }}; padding: 3rem; }
        code { background:#fff; padding:.2rem .4rem; border-radius:4px; }
    </style>
</head>
<body>
    <h1>Hello from {{ site_config.title }} 🚀</h1>
    <p><strong>Hostname:</strong>     <code>{{ ansible_hostname }}</code></p>
    <p><strong>FQDN:</strong>         <code>{{ ansible_fqdn }}</code></p>
    <p><strong>Virtual host:</strong> <code>{{ site_config.server_name }}</code></p>
    <p><strong>Managed by:</strong>   Ansible</p>
</body>
</html>