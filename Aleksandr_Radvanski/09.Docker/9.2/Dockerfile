# 1. Указываем базовый образ с установленной Node.js (версия LTS на Alpine Linux для легковесности)
FROM node:20-alpine

# 2. Настраиваем переменную среды (например, для обозначения production-режима)
ENV NODE_ENV=production

# 3. Создаем и устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# 4. Копируем файлы манифестов зависимостей в рабочую директорию
COPY package.json ./

# 5. Устанавливаем зависимости приложения внутри образа
#RUN npm install --only=production старая версия
RUN npm install --omit=dev


# 6. Копируем оставшийся исходный код приложения в контейнер
COPY . .

# 7. Информируем Docker, что приложение внутри контейнера использует порт 3000
EXPOSE 3000

# 8. Определяем команду, которая запустит приложение при старте контейнера
CMD ["node", "app.js"]
