<?xml version="1.1" encoding="UTF-8"?>
<project>
  <actions/>
  <description>Checks whether a requested local user exists in /etc/passwd</description>
  <logRotator class="hudson.tasks.LogRotator">
    <daysToKeep>-1</daysToKeep>
    <numToKeep>30</numToKeep>
    <artifactDaysToKeep>-1</artifactDaysToKeep>
    <artifactNumToKeep>-1</artifactNumToKeep>
    <removeLastBuild>false</removeLastBuild>
  </logRotator>
  <keepDependencies>false</keepDependencies>
  <properties>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition>
          <name>USERNAME</name>
          <description>Linux user name to check</description>
          <defaultValue>root</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <scm class="hudson.scm.NullSCM"/>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/>
  <concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.Shell>
      <command>#!/bin/sh
set -eu

case &quot;${USERNAME}&quot; in
  &apos;&apos;|*[!A-Za-z0-9._-]*)
    echo &quot;Invalid user name: only letters, digits, dot, underscore and dash are allowed.&quot;
    exit 2
    ;;
esac

if awk -F: -v username=&quot;${USERNAME}&quot; &apos;$1 == username { found=1 } END { exit !found }&apos; /etc/passwd; then
  echo &quot;User &apos;${USERNAME}&apos; exists in /etc/passwd.&quot;
else
  echo &quot;User &apos;${USERNAME}&apos; does not exist in /etc/passwd.&quot;
fi
</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>
  </builders>
  <publishers/>
  <buildWrappers/>
</project>
